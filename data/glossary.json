{
  "about": "全資料共通の訳語。scripts/check_glossary.py が訳文を照合する。en があれば、英文がそれに当たるブロックだけを調べる。replace が true の規則は scripts/unify_terms.py が機械的に置き換える（forbid に当たる部分を ja にする）。それ以外は 1 件ずつ判定し、許容したものは data/glossary-exceptions.json に記録する。",
  "rules": [
    {"id": "server", "ja": "サーバー", "forbid": "サーバ(?![ーン])", "replace": true, "note": "長音ありに統一（2026-11-28 利用者指示）"},
    {"id": "user", "ja": "ユーザー", "forbid": "ユーザ(?!ー|ビリティ|ブル)", "replace": true, "note": "ユーザビリティ・ユーザブルは別語"},
    {"id": "interface", "ja": "インターフェース", "forbid": "インタフェ[ーイ]ス", "replace": true},
    {"id": "parameter", "ja": "パラメーター", "forbid": "パラメータ(?!ー)", "replace": true},
    {"id": "computer", "ja": "コンピューター", "forbid": "コンピュータ(?!ー)", "replace": true},
    {"id": "stakeholder", "ja": "利害関係者", "forbid": "ステークホルダー?", "replace": true, "note": "多数派に統一（2026-11-28 利用者指示）"},
    {"id": "nonce", "ja": "ノンス", "forbid": "(?<![ァ-ヶー])ナンス", "replace": true, "note": "多数派に統一（2026-11-28 利用者指示）。ガバナンス・ファイナンスなどは対象外"},
    {"id": "accreditation", "ja": "認定", "forbid": "アクレディテーション", "replace": true, "note": "第 10 陣で決定"},
    {"id": "keying-material", "ja": "鍵素材", "forbid": "鍵材料", "replace": true},
    {"id": "trust-anchor", "ja": "トラストアンカー", "forbid": "信頼アンカー", "replace": true},
    {"id": "post-quantum", "en": "post-quantum|\\bPQC\\b", "ja": "耐量子", "forbid": "ポスト量子|量子後", "replace": true},
    {"id": "attestation", "en": "attest", "ja": "アテステーション", "forbid": "構成証明(?:（アテステーション）)?", "replace": true, "note": "第 3 陣で決定"},
    {"id": "private-key", "en": "private", "ja": "秘密鍵", "forbid": "私有鍵|プライベート鍵|私有(?:署名|認可|認証)鍵"},
    {"id": "root-of-trust", "en": "roots? of trust", "ja": "ルートオブトラスト", "forbid": "信頼の(?:基点|起点|ルート|根)", "note": "多数派に統一（2026-11-28 利用者指示）"},
    {"id": "authenticator", "en": "authenticator", "ja": "認証器", "forbid": "認証子|オーセンティケータ"},
    {"id": "threat-actor", "en": "threat actor", "ja": "脅威アクター", "forbid": "脅威主体|脅威行為者|脅威アクタ(?!ー)"},
    {"id": "mode-of-operation", "en": "modes? of operation", "ja": "暗号利用モード", "forbid": "(?<!暗号)(?:動作|運用|利用|操作)モード", "note": "暗号のモードは暗号利用モード（2026-11-28 利用者指示）。システムの動作モード・運用モードは例外に記録する"},
    {"id": "subscriber", "en": "subscriber", "ja": "加入者", "forbid": "サブスクライバ|契約者"},
    {"id": "provenance", "en": "provenance", "ja": "来歴", "forbid": "出所|由来|出自"},
    {"id": "integrity", "en": "integrity", "ja": "完全性", "forbid": "整合性"},
    {"id": "revocation", "en": "revocation|revok", "ja": "失効", "forbid": "取り?消し|破棄"},
    {"id": "sensitive", "en": "\\bsensitive\\b", "ja": "機微", "forbid": "機密", "unless_en": "classif|confidential|secret", "note": "NIST では sensitive（機微）と classified（機密）は別の概念"}
  ]
}
